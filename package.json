{
  "name": "zapsmtp-mcp",
  "version": "0.1.1",
  "description": "The official ZapSMTP MCP server: send, receive and track email from Claude, Cursor, VS Code, Codex and any MCP client",
  "license": "MIT",
  "homepage": "https://zapsmtp.com/docs/sdks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZapSMTP/zapsmtp-mcp.git"
  },
  "bugs": "https://github.com/ZapSMTP/zapsmtp-mcp/issues",
  "keywords": ["mcp", "model context protocol", "email", "smtp", "transactional email", "zapsmtp", "ai", "agents"],
  "type": "module",
  "engines": { "node": ">=18.3" },
  "bin": { "zapsmtp-mcp": "dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "docs", "README.md"],
  "scripts": {
    "generate": "node ../codegen/generate.mjs --only mcp",
    "docs": "node scripts/bundle-docs.mjs",
    "build": "node ../codegen/generate.mjs --check --only mcp && npm run -s compile",
    "compile": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/bin.js && node scripts/bundle-docs.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zapsmtp": "file:../node"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
